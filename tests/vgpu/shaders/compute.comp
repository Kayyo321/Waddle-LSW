// Owned Vulkan 1.0 test shader; one invocation writes one uint32 result.
// Dispatch exactly 64 workgroups into a storage buffer of at least 256 bytes.
#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer output_buffer_t {
    uint values[];
} output_data;
void main() {
    uint index = gl_GlobalInvocationID.x;
    output_data.values[index] = index * 13 + 7;
}
