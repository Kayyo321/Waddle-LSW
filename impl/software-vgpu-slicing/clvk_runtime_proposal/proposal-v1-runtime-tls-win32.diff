+def read_image(path):
+    """Return (bytes, image base, sections) of a borrowed PE32+ file.
+
+    Each section is (virtual address, virtual size, raw offset, raw size,
+    characteristics). Raises SystemExit for a non-PE32+ input. Read-only.
+    """
+    import struct
+    data = Path(path).read_bytes()
+    header = struct.unpack_from('<I', data, 0x3c)[0]
+    if data[header:header + 4] != b'PE\0\0' or struct.unpack_from('<H', data, header + 24)[0] != 0x20b:
+        raise SystemExit('Not a PE32+ image: %s' % path)
+    count, optional_size = struct.unpack_from('<H', data, header + 6)[0], struct.unpack_from('<H', data, header + 20)[0]
+    base = struct.unpack_from('<Q', data, header + 48)[0]
+    sections = []
+    for index in range(count):
+        entry = header + 24 + optional_size + 40 * index
+        size, address, raw_size, raw_offset = struct.unpack_from('<IIII', data, entry + 8)
+        sections.append((address, size, raw_offset, raw_size, struct.unpack_from('<I', data, entry + 36)[0]))
+    return data, base, sections
+
+
+def image_offset(sections, rva):
+    """Map an RVA to a file offset; raise SystemExit when it is not file-backed."""
+    for address, size, raw_offset, raw_size, _ in sections:
+        if address <= rva < address + min(size, raw_size):
+            return raw_offset + rva - address
+    raise SystemExit('RVA 0x%x is not file-backed' % rva)
+
