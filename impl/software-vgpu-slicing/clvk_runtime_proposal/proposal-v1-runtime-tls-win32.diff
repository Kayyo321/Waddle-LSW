+#!/usr/bin/env python3
+"""Gate src/vgpu/clvk_runtime_tls.c production code under a Linux-only Win32 double.
+
+Borrow immutable source/test/tool inputs; own a fresh artifact directory. Require
+every fake-mode production function, >=90% of its lines and branches, and
+unchanged inputs. The Windows-only TEB/implicit-TLS accessor is not compiled in
+fake mode and is covered only by disassembly review and native Windows runs.
+No threshold override, suppression, rewritten source, or shared profile output.
+"""
+from datetime import datetime, timezone
+import gzip
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+MinimumPercent = 90
+ProductionFunctions = {'runtime_tls_current_record', 'runtime_tls_fail', 'runtime_tls_assign',
+                       'waddle_test___emutls_get_address', 'waddle_test___emutls_register_common',
+                       'gthread_entry', 'waddle_test___gthr_win32_create',
+                       'waddle_test___gthr_win32_join', 'waddle_test___gthr_win32_self'}
+
+
+def digest(path):
+    """[in] Borrow regular path; [out] owned SHA256; read-only synchronous lifetime."""
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main():
+    """[in] Exclusive output-root CLI; [out] retained exact production coverage proof.
+
+    Children close synchronously; errors preserve diagnostics and fail. No source
+    mutation. The caller serializes source access through completion.
+    """
+    assert len(sys.argv) == 2
+    root = Path.cwd().resolve()
+    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
+    output = Path(sys.argv[1]).resolve() / ('run-' + stamp + '-' + str(os.getpid()))
+    output.mkdir(parents=True)
+    source = root / 'src/vgpu/clvk_runtime_tls.c'
+    test = root / 'tests/vgpu/clvk_runtime_tls_test.c'
+    inputs = [source, test, root / 'tests/vgpu/clvk_runtime_tls_fake/windows.h', Path(__file__).resolve()]
+    for tool in ('cc', 'gcov'):
+        found = shutil.which(tool)
+        assert found
+        inputs.append(Path(found).resolve(strict=True))
+    manifest = {str(path): digest(path) for path in inputs}
+    commands = [
+        ['cc', '-std=c11', '-Wall', '-Wextra', '-Wpedantic', '-Werror', '-O0', '-g', '--coverage',
+         '-pthread', '-DWaddleRuntimeTlsFakeWindows', '-I' + str(root / 'tests/vgpu'),
+         str(test), '-o', str(output / 'runner')],
+        [str(output / 'runner')],
+        ['gcov', '-j', '-b', '-c', 'runner-clvk_runtime_tls_test.gcno'],
+    ]
+    for index, command in enumerate(commands):
+        with (output / ('command_' + str(index) + '.log')).open('wb') as stream:
+            subprocess.run(command, cwd=output, check=True, timeout=120, stdout=stream, stderr=stream)
+    artifact = output / 'runner-clvk_runtime_tls_test.gcov.json.gz'
+    assert artifact.stat().st_size <= 1024 * 1024
+    report = json.loads(gzip.decompress(artifact.read_bytes()))
+    files = [entry for entry in report['files'] if Path(entry['file']).resolve() == source]
+    assert len(files) == 1
+    selected = files[0]
+    assert {entry['name'] for entry in selected['functions']} == ProductionFunctions
+    lines = selected['lines']
+    branches = [branch for entry in lines for branch in entry['branches']]
+    assert lines and branches
+    line_hit = sum(entry['count'] > 0 for entry in lines)
+    branch_hit = sum(entry['count'] > 0 for entry in branches)
+    assert manifest == {str(path): digest(path) for path in inputs}, 'coverage inputs changed'
+    result = {'scope': 'runtime TLS shim production code; Linux Win32 double; no native Windows claim',
+              'lines': [line_hit, len(lines)], 'branches': [branch_hit, len(branches)],
+              'inputs': manifest}
+    (output / 'coverage.json').write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
+    line_percent = 100.0 * line_hit / len(lines)
+    branch_percent = 100.0 * branch_hit / len(branches)
+    print('runtime TLS coverage lines=%.2f%% branches=%.2f%% (%s)' % (line_percent, branch_percent, output))
+    if line_percent < MinimumPercent or branch_percent < MinimumPercent:
+        raise SystemExit('runtime TLS coverage below %d%%' % MinimumPercent)
+
+
+if __name__ == '__main__':
+    main()
