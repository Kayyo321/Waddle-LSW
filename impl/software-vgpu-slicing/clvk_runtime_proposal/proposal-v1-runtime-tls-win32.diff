+            Driver.verify_runtime_link(outputs['shim'][1])
+            audit = Driver.audit_runtime_tls(outputs['shim'][0])
+            self.assertLessEqual(set(audit['tls_alloc_sites']), set(Driver.AllowedTlsAllocSites))
