+def audit_runtime_tls(dll):
+    """Return the emulated-TLS inventory and TlsAlloc call sites of a linked DLL.
+
+    Reads `nm` COFF symbols and raw PE bytes (borrowed, unstripped DLL). Fails
+    closed when the emulated-TLS layout cannot fit the runtime TLS record, or a
+    TlsAlloc reference lies outside AllowedTlsAllocSites. The call-site scan
+    covers RIP-relative call/jmp/mov encodings of the TlsAlloc IAT slot.
+    """
+    import bisect
+    import struct
+    data, base, sections = read_image(dll)
+    symbols = []
+    controls = {}
+    for line in capture(['x86_64-w64-mingw32-nm', '-n', '--defined-only', dll]).splitlines():
+        parts = line.split()
+        if len(parts) != 3:
+            continue
+        address = int(parts[0], 16)
+        if parts[1] in 'tT':
+            symbols.append((address, parts[2]))
+        name = parts[2][6:] if parts[2].startswith('.data$') else parts[2]
+        if name.startswith('__emutls_v.'):
+            controls[address] = name
+    total = maximum_align = 0
+    for address in sorted(controls):
+        size, align = struct.unpack_from('<QQ', data, image_offset(sections, address - base))
+        align = align or 1
+        total = (total + align - 1) // align * align + size
+        maximum_align = max(maximum_align, align)
+    if len(controls) > RuntimeTlsSlotCapacity or total > RuntimeTlsArenaBytes or \
+       maximum_align > RuntimeTlsMaxAlign:
+        raise SystemExit('Emulated TLS does not fit the runtime TLS record: objects=%d bytes=%d align=%d'
+                         % (len(controls), total, maximum_align))
+    header = struct.unpack_from('<I', data, 0x3c)[0]
+    descriptor = image_offset(sections, struct.unpack_from('<I', data, header + 24 + 112 + 8)[0])
+    slot = None
+    while struct.unpack_from('<I', data, descriptor + 12)[0]:
+        lookup, _, _, _, thunks = struct.unpack_from('<IIIII', data, descriptor)
+        index = 0
+        while True:
+            entry = struct.unpack_from('<Q', data, image_offset(sections, (lookup or thunks) + 8 * index))[0]
+            if not entry:
+                break
+            if not entry >> 63:
+                start = image_offset(sections, (entry & 0x7fffffff) + 2)
+                if data[start:data.index(b'\0', start)] == b'TlsAlloc':
+                    slot = thunks + 8 * index
+            index += 1
+        descriptor += 20
+    symbols.sort()
+    starts = [item[0] for item in symbols]
+    sites = set()
+    for address, size, raw_offset, raw_size, characteristics in sections:
+        if slot is None or not characteristics & 0x20000000:
+            continue
+        code = data[raw_offset:raw_offset + min(size, raw_size)]
+        for position in range(len(code) - 7):
+            if code[position] == 0xff and code[position + 1] in (0x15, 0x25):
+                length, displacement = 6, position + 2
+            elif code[position] in (0x48, 0x4c) and code[position + 1] in (0x8b, 0xff) and \
+                    code[position + 2] & 0xc7 == 0x05:
+                length, displacement = 7, position + 3
+            else:
+                continue
+            if address + position + length + struct.unpack_from('<i', code, displacement)[0] == slot:
+                owner = bisect.bisect_right(starts, base + address + position) - 1
+                sites.add(symbols[owner][1] if owner >= 0 else '?')
+    sites.discard('TlsAlloc')
+    unexpected = sorted(sites - set(AllowedTlsAllocSites))
+    if unexpected:
+        raise SystemExit('OpenCL.dll has unpaired TlsAlloc call sites: %s' % unexpected)
+    return {'emutls_objects': len(controls), 'emutls_bytes': total, 'emutls_max_align': maximum_align,
+            'tls_alloc_sites': sorted(sites)}
+
