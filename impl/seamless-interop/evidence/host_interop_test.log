mkdir -p build
zig build-obj src/interop/interop_codec.zig -Iinclude -O ReleaseSafe -fPIC -fcompiler-rt -lc -femit-bin=build/interop_codec.o
cc -D_GNU_SOURCE -Iinclude -Isrc -Isrc/common -Isrc/cli -Isrc/daemon -Isrc/guest -Isrc/mock -O2 -g -std=c11 -Wall -Wextra -Wpedantic -Werror -UNDEBUG tests/interop/codec_abi.c build/interop_codec.o  -o build/interop_codec_abi_test
zig test src/interop/interop_codec.zig -Iinclude -lc
