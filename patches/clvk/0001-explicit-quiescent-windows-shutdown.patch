+/** Private C ABI version 1. Call only outside the loader lock after stopping
+ * all application CL callers, finishing queues and releasing all CL handles.
+ * No CL call may overlap shutdown or use stale platform/device IDs afterwards.
+ * Returns 0 on terminal success (including repeats), 1 for retained owners or
+ * active executors, 2 for unsupported ABI, 3 for disabled global destruction.
+ * Busy/config/version failures preserve every owner and permit later retry.
+ * Successful shutdown never reinitializes state during this DLL load. */
+extern "C" int32_t waddle_clvk_shutdown(uint32_t abi_version) {
+    if (abi_version != 1) {
+        return 2;
+    }
+    std::lock_guard<std::mutex> lock(waddle_lifetime.mutex);
+    if (waddle_lifetime.terminal) {
+        return 0;
+    }
+    if (gGlobalState != nullptr) {
+        if (!config.destroy_global_state) {
+            return 3;
+        }
+        const auto& devices = gGlobalState->platform()->devices();
+        // Check counted allocations first: executor queue destruction itself
+        // can need the global getter/pool lock. Never join with an owner live.
+        if (waddle_lifetime.live_objects.load(std::memory_order_acquire) != devices.size()) {
+            return 1;
+        }
+        for (auto device : devices) {
+            if (device->refcount() != 1) {
+                return 1;
+            }
+        }
+        if (!waddle_lifetime.can_shutdown(devices.size(), gGlobalState->thread_pool()->waddle_quiescent())) {
+            return 1;
+        }
+    } else if (!waddle_lifetime.can_shutdown(0, true)) {
+        return 1;
+    }
+    waddle_lifetime.terminal = true;
+    destroy_global_state();
+    return 0;
+}
