+// Waddle private embedding lifetime guard; applied only to the pinned build copy.
+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <mutex>
+
+/** Process-local ownership ledger. All refcounted objects contribute exactly
+ * one live allocation regardless of retained references. The embedding owner
+ * excludes concurrent API calls during terminal shutdown. Counter operations
+ * are atomic; mutex serializes lazy initialization and explicit shutdown. */
+struct waddle_lifetime_t {
+    /// Atomic allocation count; each counted owner increments/decrements once.
+    std::atomic<size_t> live_objects{0};
+    /// Serializes initialization/shutdown; borrowed only while locked.
+    std::mutex mutex;
+    /// Sticky successful terminal state, protected by mutex.
+    bool terminal = false;
+
+    /** Check the complete baseline without mutation or ownership transfer.
+     * Caller holds mutex, has excluded API callers and supplies the exact
+     * platform root-device count and a separately locked executor-idle proof. */
+    bool can_shutdown(size_t root_count, bool executors_idle) const {
+        return live_objects.load(std::memory_order_acquire) == root_count &&
+               executors_idle;
+    }
+};
+/** Inline process-local ledger; no external allocation or ownership transfer. */
+inline waddle_lifetime_t waddle_lifetime;
