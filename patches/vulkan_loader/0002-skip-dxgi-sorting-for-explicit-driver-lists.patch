+// An explicit driver list (VK_DRIVER_FILES, else VK_ICD_FILENAMES) is the same override that makes
+// loader_get_data_files skip the registry. With it, DXGI adapter-preference sorting is skipped too,
+// exactly as when DXGI factory creation fails: no DXGI factory is created, so dxgi, dxcore and their
+// RPC/ALPC clients never start in the process.
+bool windows_explicit_driver_list(const struct loader_instance *inst) {
+    char *files = loader_secure_getenv(VK_DRIVER_FILES_ENV_VAR, inst);
+    if (NULL == files) {
+        files = loader_secure_getenv(VK_ICD_FILENAMES_ENV_VAR, inst);
+    }
+    bool explicit_list = NULL != files;
+    loader_free_getenv(files, inst);
+    return explicit_list;
+}
