 typedef HRESULT(APIENTRY *PFN_CreateDXGIFactory1)(REFIID riid, void **ppFactory);
 PFN_CreateDXGIFactory1 fpCreateDXGIFactory1;
+// Module references taken by windows_initialization and released by windows_teardown, so a
+// dynamically unloaded loader does not leave gdi32.dll and dxgi.dll referenced forever.
+static HMODULE windows_gdi32_module;
+static HMODULE windows_dxgi_module;
 
 // Empty function just so windows_initialization can find the current module location
